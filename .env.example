# =================================================================
# ESS CHATBOT SaaS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# All values below are placeholder defaults. 
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.com

# PostgreSQL Credentials (Must match between Container and Connection String)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_DB=ess_chatbot

# PostgreSQL Connection String (Constructed from above credentials)
# Internal Docker Network format:
DATABASE_URL="postgresql://postgres:your_strong_postgres_password_here@postgres:5432/ess_chatbot?schema=public"
# Host-access format (if using external/managed database):
# DATABASE_URL="postgresql://postgres:your_strong_postgres_password_here@127.0.0.1:5432/ess_chatbot?schema=public"

# AI Inference Providers
# Default Provider: "groq" (sub-second cloud LPU) or "ollama" (local server CPU/GPU)
DEFAULT_AI_PROVIDER=groq

# Groq Cloud LPU Inference (Recommended for sub-second responses)
GROQ_API_KEY="gsk_your_actual_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Local / Self-Hosted Ollama Inference
OLLAMA_URL="http://ollama:11434"
CHAT_MODEL="llama3.2:1b"

# Lead Generation & Webhook Dispatch
# Secret used to sign outgoing webhook payloads with HMAC SHA-256
LEAD_WEBHOOK_URL="https://your-crm.com/api/webhooks/leads"
LEAD_WEBHOOK_SECRET="whsec_your_hmac_sha256_shared_secret_here"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
# Allowed CORS origins for widget embedding (* or comma-separated domains)
ALLOWED_ORIGINS="https://visionexims.com,https://emperorsmartsolutions.com"
