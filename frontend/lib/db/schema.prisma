// Prisma Schema definition for Chatbot SaaS with Website Knowledge & Widget Integration
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  plan          String          @default("Starter") // Starter, Growth, Enterprise
  status        String          @default("ACTIVE")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  users         User[]
  bots          Bot[]
  websiteSources WebsiteSource[]
  ingestionJobs IngestionJob[]
  installations WidgetInstallation[]
}

model User {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  email          String        @unique
  role           String        @default("MEMBER") // OWNER, ADMIN, MEMBER
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Bot {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  description    String?
  avatar         String          @default("🤖")
  primaryColor   String          @default("#4f46e5")
  status         String          @default("Active") // Active, Draft, Disabled
  systemPrompt   String?
  welcomeMessage String          @default("Hello! How can I help you today?")
  launcherPosition String        @default("bottom-right") // bottom-right, bottom-left
  brandingEnabled Boolean        @default(true)
  globalBotEnabled Boolean       @default(true)
  fallbackMessage String?        @default("Our automated assistant is temporarily paused. A team member will assist you shortly.")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websiteSources WebsiteSource[]
  ingestionJobs  IngestionJob[]
  installations  WidgetInstallation[]
  conversations  Conversation[]
  visitors       Visitor[]
  leads          Lead[]
  documents      KnowledgeDocument[]
  webhooks       WebhookConfig[]

  @@index([organizationId])
}

model WebsiteSource {
  id              String         @id @default(cuid())
  organizationId  String
  botId           String
  name            String
  baseUrl         String
  crawlScope      String         @default("entire") // homepage, selected, entire
  maxPages        Int            @default(50)
  includePatterns String[]       @default([])
  excludePatterns String[]       @default([])
  syncSchedule    String         @default("manual") // manual, daily, weekly
  status          String         @default("Pending") // Pending, Crawling, Indexing, Ready, Failed, Paused
  pagesDiscovered Int            @default(0)
  pagesIndexed    Int            @default(0)
  pagesSkipped    Int            @default(0)
  pagesFailed     Int            @default(0)
  lastSyncedAt    DateTime?
  lastError       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot             Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  pages           WebsitePage[]
  jobs            IngestionJob[]

  @@index([organizationId, botId])
  @@index([baseUrl])
}

model WebsitePage {
  id              String        @id @default(cuid())
  websiteSourceId String
  botId           String
  organizationId  String
  url             String
  canonicalUrl    String?
  title           String?
  description     String?
  contentHash     String
  crawlStatus     String        @default("Pending") // Pending, Indexed, Excluded, Failed
  chunksCount     Int           @default(0)
  httpStatus      Int           @default(200)
  lastIndexedAt   DateTime?
  lastError       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  websiteSource   WebsiteSource @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)

  @@index([websiteSourceId])
  @@index([botId, url])
}

model IngestionJob {
  id              String        @id @default(cuid())
  organizationId  String
  botId           String
  websiteSourceId String
  jobStatus       String        @default("Pending") // Pending, Discovering, Crawling, Extracting, Embedding, Indexing, Completed, CompletedWithErrors, Failed, Cancelled
  currentStep     String        @default("Queued")
  progress        Int           @default(0) // 0-100
  discoveredCount Int           @default(0)
  indexedCount    Int           @default(0)
  failedCount     Int           @default(0)
  startedAt       DateTime      @default(now())
  finishedAt      DateTime?
  errorDetails    String?

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  websiteSource   WebsiteSource @relation(fields: [websiteSourceId], references: [id], onDelete: Cascade)

  @@index([organizationId, botId])
  @@index([websiteSourceId])
}

model WidgetInstallation {
  id              String        @id @default(cuid())
  organizationId  String
  botId           String
  domain          String
  cmsProvider     String?       // custom, wordpress, shopify, webflow
  installationType String       @default("script") // script, api_plugin
  installationStatus String     @default("Unverified") // Unverified, Verified, Failed
  lastVerifiedAt  DateTime?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([botId, domain])
  @@index([botId])
}

model Visitor {
  id                 String         @id @default(cuid())
  organizationId     String
  botId              String
  visitorTokenHash   String
  leadId             String?
  name               String?
  email              String?
  phone              String?
  metadata           Json?          @default("{}")
  lastSeenAt         DateTime       @default(now())
  lastConversationAt DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  bot                Bot            @relation(fields: [botId], references: [id], onDelete: Cascade)
  conversations      Conversation[]

  @@unique([botId, visitorTokenHash])
  @@index([organizationId, botId])
}

model Conversation {
  id                 String        @id @default(cuid())
  organizationId     String
  botId              String
  visitorId          String?
  leadId             String?
  visitorName        String        @default("Website Visitor")
  visitorEmail       String?
  visitorPhone       String?
  visitorLocation    String?
  status             String        @default("Active") // Active, Closed, Archived, Expired, HUMAN_ACTIVE, WAITING_FOR_HUMAN, AI_RESUMED, Resolved
  handlingMode       String        @default("AI")     // AI, HUMAN
  assignedToId       String?
  assignedToName     String?
  assignedAt         DateTime?
  resolvedAt         DateTime?
  unreadCount        Int           @default(0)
  isLead             Boolean       @default(false)
  leadScore          String?       // Hot, High, Medium, Low
  lastMessage        String?
  qualificationState Json?         @default("{}")
  lastActivityAt     DateTime      @default(now())
  historyExpiresAt   DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  bot                Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  visitor            Visitor?      @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  messages           Message[]
  notes              InternalNote[]
  assignments        ConversationAssignment[]

  @@index([organizationId, botId])
  @@index([organizationId, handlingMode, status])
  @@index([assignedToId])
  @@index([visitorId, lastActivityAt])
  @@index([historyExpiresAt])
  @@index([createdAt])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  role            String        // user, assistant, system, agent
  senderType      String        @default("visitor") // visitor, bot, human, system
  senderId        String?
  senderName      String?
  content         String
  tokens          Int?
  latencyMs       Int?
  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model InternalNote {
  id              String        @id @default(cuid())
  conversationId  String
  organizationId  String
  authorId        String?
  authorName      String        @default("Team Member")
  content         String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([organizationId])
}

model ConversationAssignment {
  id              String        @id @default(cuid())
  conversationId  String
  assignedToId    String
  assignedToName  String?
  assignedById    String?
  assignedByName  String?
  assignedAt      DateTime      @default(now())
  releasedAt      DateTime?

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([assignedToId])
}

model WorkspaceBotSettings {
  id              String        @id @default(cuid())
  organizationId  String        @unique
  globalEnabled   Boolean       @default(true)
  fallbackMessage String        @default("Our automated assistant is temporarily paused. A team member will assist you shortly.")
  updatedById     String?
  updatedAt       DateTime      @updatedAt
}

model Lead {
  id              String        @id @default(cuid())
  organizationId  String
  botId           String
  name            String        @default("Website Prospect")
  email           String?
  phone           String?
  company         String?       @default("Direct Inbound")
  score           String        @default("Medium") // Hot, High, Medium, Low
  status          String        @default("New")    // New, Contacted, Qualified, Closed
  inquiry         String?
  budget          String?       @default("₹50,000+")
  source          String        @default("Web Chatbot Widget")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@index([organizationId, botId])
  @@index([createdAt])
}

model KnowledgeDocument {
  id              String        @id @default(cuid())
  organizationId  String
  botId           String
  name            String
  type            String        @default("PDF") // PDF, TXT, DOCX, CSV
  sizeBytes       Int           @default(0)
  status          String        @default("Ready") // Uploading, Processing, Ready, Failed
  chunksCount     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]

  @@index([organizationId, botId])
}

model KnowledgeChunk {
  id              String        @id @default(cuid())
  documentId      String
  organizationId  String
  botId           String
  chunkIndex      Int           @default(0)
  content         String
  contentHash     String?
  createdAt       DateTime      @default(now())

  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([organizationId, botId])
}

model WebhookConfig {
  id              String        @id @default(cuid())
  organizationId  String
  botId           String
  url             String
  secret          String        // HMAC signing secret
  events          String[]      @default(["lead_created", "lead_updated"])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bot             Bot           @relation(fields: [botId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([organizationId, botId])
}

model WebhookDelivery {
  id              String        @id @default(cuid())
  webhookConfigId String
  event           String
  statusCode      Int?
  responseBody    String?
  success         Boolean       @default(false)
  attemptCount    Int           @default(1)
  createdAt       DateTime      @default(now())

  webhookConfig   WebhookConfig @relation(fields: [webhookConfigId], references: [id], onDelete: Cascade)

  @@index([webhookConfigId])
}

model AuditLog {
  id              String        @id @default(cuid())
  organizationId  String
  userId          String?
  action          String        // CREATE_BOT, UPDATE_PROMPT, DELETE_DOCUMENT, EXPORT_LEADS
  resourceType    String
  resourceId      String
  ipAddress       String?
  metadata        String?
  createdAt       DateTime      @default(now())

  @@index([organizationId])
  @@index([createdAt])
}
