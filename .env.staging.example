# =================================================================
# ESS CHATBOT SaaS — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# All values below are templates for staging isolation.
# DO NOT COMMIT REAL SECRETS OR COPY PRODUCTION CREDENTIALS HERE.
# Store real staging secrets in .env.staging (STRICTLY GIT-IGNORED).
# =================================================================

# 1. Application Runtime
NODE_ENV=production
PORT=3000
FRONTEND_PORT=3301
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3301
APP_URL=http://127.0.0.1:3301

# 2. Cryptographic Secrets (MANDATORY — GENERATE UNIQUE PER ENVIRONMENT)
# Generate with: openssl rand -hex 32
SESSION_SECRET=staging_secret_replace_with_random_32_chars_minimum_hex_key_abcd
OTP_SECRET=staging_otp_replace_with_random_32_chars_minimum_hex_key_ef01

# Set to "false" since staging is accessed directly on loopback http://127.0.0.1:3301 for testing
COOKIE_SECURE=false

# 3. Dedicated Staging PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_DB=ess_chatbot_staging
POSTGRES_PORT=5499
DB_POOL_MAX=10
# Set an explicit, strong, random staging password (never production password):
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=your_strong_staging_db_password_here
DATABASE_URL=postgresql://postgres:your_strong_staging_db_password_here@postgres:5432/ess_chatbot_staging?schema=public

# 4. Dedicated Staging Redis Credentials
REDIS_HOST=redis
REDIS_PORT=6389
REDIS_URL=redis://redis:6379
AI_FAIL_CLOSED_ON_REDIS_OUTAGE=true

# 5. AI Inference Provider Selection (MOCK for zero-cost load testing)
# Options: "mock" (in-memory zero-charge simulation), "groq", "ollama"
DEFAULT_AI_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 6. Webhooks & Integrations (MOCK Endpoints ONLY)
# Never use production CRM or live SMS gateways in staging!
LEAD_WEBHOOK_URL=http://mock-webhook-receiver
LEAD_WEBHOOK_SECRET=mock_webhook_secret_staging
DLT_SMS_URI=http://mock-sms-service
DLT_SMS_APIKEY=MOCK_KEY_NO_CHARGES
ALLOWED_ORIGINS="http://127.0.0.1:3301,http://localhost:3301"

# 7. Payment Gateway (Disabled in Staging)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 8. WhatsApp Business API (Disabled in Staging)
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
