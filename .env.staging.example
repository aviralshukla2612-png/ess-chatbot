# =================================================================
# ESS CHATBOT SaaS — STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# All values below are templates for staging isolation.
# DO NOT COMMIT REAL SECRETS OR COPY PRODUCTION CREDENTIALS HERE.
# =================================================================

# 1. Application Runtime
NODE_ENV=production
PORT=3000
FRONTEND_PORT=3301
FASTAPI_PORT=8009
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3301

# 2. Session Secret (MANDATORY)
# Must be at least 32 characters, cryptographically random, unique to staging.
# Generate with: openssl rand -hex 32
SESSION_SECRET=staging_secret_replace_with_random_32_chars_minimum_hex_key_abcd

# Set to "true" ONLY when accessing staging behind an HTTPS reverse proxy with SSL termination.
# Set to "false" if accessing staging directly via http://127.0.0.1:3301 for testing.
COOKIE_SECURE=false

# 3. Dedicated Staging PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_DB=ess_chatbot_staging
DB_POOL_MAX=10
# Set an explicit, strong, random staging password (never production password):
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=your_strong_staging_db_password_here

# 4. PostgreSQL Connection String
# IMPORTANT: If your password contains special characters like '@', ':', '/', '#', or '%',
# you MUST percent-encode them in DATABASE_URL (e.g. '@' -> '%40', ':' -> '%3A', '#' -> '%23').
# Unencoded special characters will cause URL parsing failures in envValidator.js.
DATABASE_URL=postgresql://postgres:your_strong_staging_db_password_here@postgres:5432/ess_chatbot_staging?schema=public

# 5. AI Inference Provider Selection
# Options: "groq" (cloud LPU) or "ollama" (self-contained local container)
DEFAULT_AI_PROVIDER=groq

# 5a. Groq Cloud LPU (Recommended for fast inference in staging if API quota available)
# Obtain a dedicated staging/test key from https://console.groq.com
GROQ_API_KEY=gsk_your_staging_test_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 5b. Local Self-Contained Ollama (Runs inside ess-ollama-staging)
OLLAMA_URL=http://ollama:11434
CHAT_MODEL=llama3.2:1b
EMBED_MODEL=nomic-embed-text

# 6. Webhooks & Integrations (Test/Staging Endpoints ONLY)
# Never use production CRM or live webhook endpoints in staging!
LEAD_WEBHOOK_URL=https://webhook.site/your-staging-test-uuid
LEAD_WEBHOOK_SECRET=whsec_staging_test_hmac_secret_123456

# Allowed CORS origins for widget testing
ALLOWED_ORIGINS="http://127.0.0.1:3301,https://staging.emperorsmartsolutions.com"

# 7. Payment Gateway (Razorpay Sandbox/Test Mode Only)
# Leave blank to disable billing checkout during testing, or use rzp_test_ keys:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 8. WhatsApp Business API (Sandbox/Test Mode Only)
# Leave blank to keep WhatsApp messaging channel disabled:
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
